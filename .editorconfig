root = true

[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
# https://docs.microsoft.com/dotnet/fundamentals/code-analysis/style-rules/
dotnet_diagnostic.IDE0001.severity = error # Simplify names
dotnet_diagnostic.IDE0002.severity = error # Simplify member access
dotnet_diagnostic.IDE0003.severity = warning # Remove qualification
dotnet_diagnostic.IDE0004.severity = error # Remove unnecessary cast
dotnet_diagnostic.IDE0005.severity = error # Remove unnecessary imports
dotnet_diagnostic.IDE0036.severity = error # Sort modifiers
dotnet_diagnostic.IDE0040.severity = error # Add accessibility modifier
dotnet_diagnostic.IDE0049.severity = error # Use keyword for type name
dotnet_diagnostic.IDE0055.severity = error # Fix formatting
dotnet_diagnostic.IDE0051.severity = warning # Private method is unused
dotnet_diagnostic.IDE0052.severity = warning # Private member is unused
dotnet_diagnostic.IDE0130.severity = error # Namespace mismatch with folder
dotnet_diagnostic.IDE1006.severity = error # Naming style

dotnet_naming_style.pascalcase.capitalization = pascal_case
dotnet_naming_style.camelcase.capitalization = camel_case
dotnet_naming_style.all_upper.capitalization = all_upper
dotnet_naming_style.all_upper.word_separator = _
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# Interface naming
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interface_starts_with_i.severity = error
dotnet_naming_rule.interface_starts_with_i.symbols = interfaces
dotnet_naming_rule.interface_starts_with_i.style = prefix_i

# PascalCase for methods
dotnet_naming_symbols.all_methods.applicable_kinds = method
dotnet_naming_rule.all_methods_pascalcase.severity = error
dotnet_naming_rule.all_methods_pascalcase.symbols = all_methods
dotnet_naming_rule.all_methods_pascalcase.style = pascalcase

# PascalCase public members 
dotnet_naming_symbols.public_members.applicable_accessibilities = public,internal,protected,protected_internal,private_protected
dotnet_naming_symbols.public_members.applicable_kinds = property,field,event
dotnet_naming_rule.public_members_pascalcase.severity = error
dotnet_naming_rule.public_members_pascalcase.symbols = public_members
dotnet_naming_rule.public_members_pascalcase.style = pascalcase

# camelCase private memebers
dotnet_naming_symbols.private_members.applicable_accessibilities = private
dotnet_naming_symbols.private_members.applicable_kinds = property,field,event
dotnet_naming_rule.private_members_camelcase.severity = error
dotnet_naming_rule.private_members_camelcase.symbols = private_members
dotnet_naming_rule.private_members_camelcase.style = camelcase

# ALL_UPPER for public constants/static readonlys
dotnet_naming_symbols.public_constants.applicable_accessibilities = public,internal,protected,protected_internal,private_protected
dotnet_naming_symbols.public_constants.required_modifiers = const
dotnet_naming_symbols.public_constants.applicable_kinds = field
dotnet_naming_rule.public_const_all_upper.severity = error
dotnet_naming_rule.public_const_all_upper.symbols = public_constants
dotnet_naming_rule.public_const_all_upper.style = all_upper
dotnet_naming_symbols.public_static_readonly.applicable_accessibilities = public,internal,protected,protected_internal,private_protected
dotnet_naming_symbols.public_static_readonly.required_modifiers = static,readonly
dotnet_naming_symbols.public_static_readonly.applicable_kinds = field
dotnet_naming_rule.public_static_readonly_all_upper.severity = error
dotnet_naming_rule.public_static_readonly_all_upper.symbols = public_static_readonly
dotnet_naming_rule.public_static_readonly_all_upper.style = all_upper

# ALL_UPPER for private constants/static readonlys
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_rule.private_const_all_upper.severity = error
dotnet_naming_rule.private_const_all_upper.symbols = private_constants
dotnet_naming_rule.private_const_all_upper.style = all_upper
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static,readonly
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_rule.private_static_readonly_all_upper.severity = error
dotnet_naming_rule.private_static_readonly_all_upper.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_all_upper.style = all_upper